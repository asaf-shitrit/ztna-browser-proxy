{
  "name": "ztna-browser-proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @ztna/extension typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist apps/*/dist tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo apps/*/tsconfig.tsbuildinfo",
    "mint-token": "node scripts/mint-token.mjs",
    "certs": "bash infra/certs/generate.sh",
    "up": "bash scripts/up.sh",
    "dev": "bash scripts/dev-native.sh",
    "verify": "bash scripts/verify-native.sh",
    "fetch-keycloak": "bash scripts/fetch-keycloak.sh",
    "test:browser": "node scripts/browser-test.mjs",
    "fetch-chrome": "bash scripts/fetch-chrome-for-testing.sh",
    "down": "docker compose -f infra/docker-compose.yml down",
    "test:redis": "docker run --rm -d --name ztna-test-redis -p 6399:6379 redis:7-alpine >/dev/null && vitest run apps/pop/test/redis-store.test.ts; docker rm -f ztna-test-redis >/dev/null"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.28.1"
}
