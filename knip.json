{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/pop": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/connector": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/demo-app": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/extension": {
      "entry": ["src/background.ts", "src/popup.tsx", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
