{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/pop": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/connector": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/demo-app": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/extension": {
      "entry": ["src/background.ts", "src/popup.tsx", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },

  // lint-staged is invoked from .husky/pre-commit. knip reads the import graph
  // and package manifests, not shell scripts, so it cannot see that use — the
  // dependency is real, the blind spot is knip's.
  "ignoreDependencies": ["lint-staged"]
}
