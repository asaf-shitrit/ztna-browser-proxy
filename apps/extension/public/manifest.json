{
  "manifest_version": 3,
  "name": "ZTNA Access",
  "description": "Zero-trust access to private applications, without a VPN.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "proxy",
    "storage",
    "identity",
    "alarms",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ZTNA Access",
    "default_popup": "popup.html"
  }
}
